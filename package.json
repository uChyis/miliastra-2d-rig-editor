{
  "name": "miliastra-2d-rig-editor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "面向原神千星奇域（UGC）的 2D 关节/骨骼编辑与绑定工具，导出可直接使用的千星客户端 Lua",
  "keywords": [
    "genshin-impact",
    "miliastra",
    "ugc",
    "2d",
    "rig",
    "skeleton",
    "ik",
    "verlet",
    "konva",
    "lua"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
